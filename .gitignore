# Go agent
/agent/dist/
/agent/.cache/
/agent/internal/bundle/*
!/agent/internal/bundle/.gitkeep
!/agent/internal/bundle/bundle.go
*.exe
*.test
*.out

# Release output and signing keys
/dist/
*.key

# Flutter app
/app/**/.dart_tool/
/app/**/build/
/app/**/.flutter-plugins
/app/**/.flutter-plugins-dependencies
/app/**/*.iml
/app/**/.idea/

/app/assets/agent/*.json
/app/assets/agent/*.sig
/app/assets/agent/amd64/*
!/app/assets/agent/amd64/.gitkeep
/app/assets/legal/*
!/app/assets/legal/.gitkeep
